# vllm-kb 密钥环境变量模板（复制为 .env 或直接 export；密钥不入库，见 .gitignore）
# 用法:  set -a; source .env; set +a        (bash)
#        Get-Content .env | ForEach-Object { $env:($_ -split '=')[0] = ($_ -split '=', 2)[1] }   (PowerShell)
#
# 也可经审核工作台（review_ui → API 配置 → 编辑配置）填写，写入 data/secrets.local.json，
# 任何入口 AppConfig.load 自动加载（无需手工 export）。

# GitHub 采集 token（拉取 issues/PRs/comments 必需；未认证限流 60 次/小时）
GITHUB_TOKEN=ghp_xxx

# Embedding API key（OpenAI 兼容端点，指向其他服务器的 vLLM 部署；本地 embedding 不做）
EMBEDDING_API_KEY=sk-xxx

# OCR API key（可选；ocr_provider=api 时使用）
OCR_API_KEY=
